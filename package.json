{
  "name": "art-supply-manager",
  "version": "1.43.1",
  "private": true,
  "type": "module",
  "description": "アトリコ（画材の在庫を管理するアプリ。保管場所フォルダ分け・在庫管理・バーコード/JAN読み取り）",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "serve": "python3 -m http.server 8080",
    "build": "node scripts/build.mjs",
    "ios:add": "npm run build && npx cap add ios && node scripts/configure-ios.mjs",
    "ios:sync": "npm run build && npx cap sync ios && node scripts/configure-ios.mjs",
    "ios:open": "npx cap open ios",
    "ios:assets": "python3 scripts/generate-ios-assets.py",
    "dict:add": "node scripts/add-jan-extra.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/share": "^6.0.4",
    "cordova-plugin-purchase": "^13.20.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
